# Existing application secrets
OPENAI_API_KEY=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Public application URL. Use a tunnel while testing callbacks, then your domain.
APP_BASE_URL=http://localhost:3000

# PayPlus sandbox credentials
PAYPLUS_SANDBOX=true
PAYPLUS_API_KEY=
PAYPLUS_SECRET_KEY=
PAYPLUS_PAYMENT_PAGE_UID=
PAYPLUS_TERMINAL_UID=
# Generate a long random value; do not reuse an API key.
PAYPLUS_REFERENCE_SECRET=

# Firebase Console > Project settings > Service accounts > Generate new private key
# Paste the complete downloaded JSON on one line.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=ofek-ai-55f1d

# PWA push notifications. The VAPID value here is the PUBLIC Web Push key;
# never store a VAPID private key in this repository or public JavaScript.
PUSH_NOTIFICATIONS_ENABLED=false
FIREBASE_WEB_PUSH_VAPID_PUBLIC_KEY=
# Keep false in production. Enable only in a controlled development/emulator
# environment to expose the authenticated self-device test action.
PUSH_TEST_NOTIFICATIONS_ENABLED=false
